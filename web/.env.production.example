# 本番 env チェックリスト（Amplify Hosting コンソール → Environment variables）
#
# このファイルは「Amplify コンソールに何を設定すべきか」の SSOT（値は入れない・コミット可）。
# 実際の本番値は Amplify コンソールに登録 → amplify.yml がビルド時に .env.production へ
# 書き出して Next.js SSR ランタイムへ渡す（コンソール変数は compute へ自動伝播しないため）。
# amplify.yml の whitelist（env|grep ...）と本ファイルのキー集合は一致させること。

# --- Stripe（本番モード）---
# 本番シークレットキー（sk_live_...）。テストキー（sk_test_）と取り違え厳禁。
STRIPE_SECRET_KEY=
# 本番 Webhook エンドポイント（/api/stripe/webhook）の署名シークレット（whsec_...）。
# Stripe ダッシュボード（本番）で endpoint を作成し checkout.session.completed を購読。
STRIPE_WEBHOOK_SECRET=

# --- 認証（所有モデル §4.7）---
# 署名 cookie の HMAC 鍵。dev とは別の十分長いランダム値（例: openssl rand -base64 48）。
# ローテーション = 全所有 cookie 無効化（全員マジックリンク復元が要る）ため安定運用。
AUTH_SECRET=

# --- メール配送（Amazon SES・マジックリンク復元のみ）---
# ★本番化の最優先 = SES サンドボックス脱出（Production access 申請）。
#   サンドボックス中は検証済みアドレス宛にしか送れず、別端末復元が他人に届かない。
SES_REGION=ap-northeast-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# SES で検証済みの送信元（独自ドメイン推奨: no-reply@tenzu.jp 等）。
SES_FROM_EMAIL=
# 問い合わせフォーム（/contact）の通知先（カンマ区切り）。未設定なら既定の 2 宛先。
# ⚠ SES サンドボックス中は宛先も SES で検証済みである必要がある（未検証だと通知
#   だけ失敗し、DynamoDB 保存＋/admin/contact 閲覧は動く）。
CONTACT_NOTIFY_EMAILS=tenzu.info@gmail.com,k-sudou@hotmail.co.jp

# --- 計測（GTM / GA4）---
# Google Tag Manager コンテナ ID（GTM-XXXXXXX）。GA4 等のタグは GTM 側で管理する。
# 未設定なら計測はまるごと no-op（dev はこれで良い）。NEXT_PUBLIC_ 付き＝ビルド時に
# クライアントへ焼き込まれるため、値の変更にはリビルド（再デプロイ）が必要。
NEXT_PUBLIC_GTM_ID=

# --- サイト URL ---
# 本番の絶対 URL。Checkout の success/cancel・メールリンクの生成に使う
# （Amplify SSR では req origin が内部ホストへ化けるため明示必須）。
# ★検索インデックスの可否もこの値で決まる（web/app/site.ts の IS_PREVIEW）。
#   ホストが *.amplifyapp.com / localhost の間は全ページ noindex になるため、
#   tenzu.jp 接続時にここを直し忘れると本番が丸ごと検索結果に出ない。
#   確認方法: 本番の任意ページで `<meta name="robots">` が index, follow か、
#   /robots.txt に `Sitemap: https://tenzu.jp/sitemap.xml` が出ているか。
SITE_URL=https://tenzu.jp

# 記事の下書き（content/articles/*.mdx の `status: draft`）を表示するか。
# ★本番では絶対に設定しない（未設定＝隠す、が唯一の安全なデフォルト）。
#   SITE_URL には乗せていない。設定漏れが noindex なら安全側に倒れるのに対し、
#   下書き公開は逆向きに倒れて事故るため、専用の env で明示的に開ける設計。
#   staging（Amplify の deploy/amplify ブランチ）と web/.env.local にだけ 1 を置く。
# SHOW_DRAFTS=1

# --- オンサイトメッセージ（管理画面 /admin/onsite・decisions.md §5.15）---
# 管理ログインの合言葉。十分長いランダム値（例: openssl rand -base64 32）。
# レート制限を持たないため、このエントロピーだけが総当たり耐性になる。
ADMIN_SECRET=
# キャンペーン定義＋日次カウンタ＋問い合わせ履歴（PK="CONTACT"）の DynamoDB テーブル名
# （PK/SK 文字列・オンデマンド）。
# dev は web/.env.local で tenzu-onsite-dev を指す。未設定なら機能まるごと degrade
# （カード非表示・計測 no-op・管理画面はエラー表示）。
ONSITE_TABLE=tenzu-onsite
# カード画像の S3 バケット（onsite/* プレフィックスのみ公開読み取りポリシー）。
ONSITE_IMAGE_BUCKET=tenzu-onsite-assets
# DynamoDB / S3 用の認証情報。SES と同一 IAM ユーザーのキーを別名で再掲する
# （Amplify は AWS_ 接頭辞を予約済み・SES_* は email.ts 専用の歴史的命名のため）。
# 未設定なら既定チェーン（Amplify compute ロール等）にフォールバック。
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=

# --- 設定してはいけないもの（本番）---
# MAKER_DEBUG_OWN_ALL … 全メーカー所有扱いの dev フラグ。本番では未設定（NODE_ENV ガードもあり）。
# STRIPE_PRICE_ENTRY / STRIPE_PRICE_FULL … 旧サブスク。checkout は price_data 直書きで不要。
# UPSTASH_REDIS_REST_URL / _TOKEN … 旧 OTP ストア。所有モデルで廃止・参照ゼロ。
