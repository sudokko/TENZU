# 本番 env チェックリスト（Amplify Hosting コンソール → Environment variables）
#
# このファイルは「Amplify コンソールに何を設定すべきか」の SSOT（値は入れない・コミット可）。
# 実際の本番値は Amplify コンソールに登録 → amplify.yml がビルド時に .env.production へ
# 書き出して Next.js SSR ランタイムへ渡す（コンソール変数は compute へ自動伝播しないため）。
# amplify.yml の whitelist（env|grep ...）と本ファイルのキー集合は一致させること。

# --- Stripe（本番モード）---
# 本番シークレットキー（sk_live_...）。テストキー（sk_test_）と取り違え厳禁。
STRIPE_SECRET_KEY=
# 本番 Webhook エンドポイント（/api/stripe/webhook）の署名シークレット（whsec_...）。
# Stripe ダッシュボード（本番）で endpoint を作成し checkout.session.completed を購読。
STRIPE_WEBHOOK_SECRET=

# --- 認証（所有モデル §4.7）---
# 署名 cookie の HMAC 鍵。dev とは別の十分長いランダム値（例: openssl rand -base64 48）。
# ローテーション = 全所有 cookie 無効化（全員マジックリンク復元が要る）ため安定運用。
AUTH_SECRET=

# --- メール配送（Amazon SES・マジックリンク復元のみ）---
# ★本番化の最優先 = SES サンドボックス脱出（Production access 申請）。
#   サンドボックス中は検証済みアドレス宛にしか送れず、別端末復元が他人に届かない。
SES_REGION=ap-northeast-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# SES で検証済みの送信元（独自ドメイン推奨: no-reply@tenzu.jp 等）。
SES_FROM_EMAIL=

# --- サイト URL ---
# 本番の絶対 URL。Checkout の success/cancel・メールリンクの生成に使う
# （Amplify SSR では req origin が内部ホストへ化けるため明示必須）。
SITE_URL=https://tenzu.jp

# --- 設定してはいけないもの（本番）---
# MAKER_DEBUG_OWN_ALL … 全メーカー所有扱いの dev フラグ。本番では未設定（NODE_ENV ガードもあり）。
# STRIPE_PRICE_ENTRY / STRIPE_PRICE_FULL … 旧サブスク。checkout は price_data 直書きで不要。
# UPSTASH_REDIS_REST_URL / _TOKEN … 旧 OTP ストア。所有モデルで廃止・参照ゼロ。
